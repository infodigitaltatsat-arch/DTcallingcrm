datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  id        String     @id @default(uuid())
  name      String
  phone     String     @unique
  email     String?
  company   String?
  status    String     @default("Lead") // Lead, Contact, Customer
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  calls     CallLog[]
  reminders Reminder[]
}

model CallLog {
  id           String   @id @default(uuid())
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName  String
  contactPhone String
  direction    String // INBOUND, OUTBOUND
  status       String // COMPLETED, MISSED, BUSY, FAILED
  duration     Int      @default(0) // in seconds
  notes        String?  @db.Text
  recordingUrl String? // URL/path to local audio file
  userId       String?
  userName     String?
  createdAt    DateTime @default(now())
}

model Reminder {
  id           String   @id @default(uuid())
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName  String
  contactPhone String
  title        String
  description  String?
  dueDate      DateTime
  status       String   @default("PENDING") // PENDING, COMPLETED, OVERDUE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  password       String
  role           String    @default("user") // admin, user, audit-secret
  lastCallAt     DateTime?
  requestedRole  String?
  approvalStatus String    @default("APPROVED") // APPROVED, PENDING, REJECTED, BLOCKED
  accountStatus  String    @default("ACTIVE") // ACTIVE, LOCKED
  lastLoginAt    DateTime?
  lastSeenAt     DateTime?
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
}
